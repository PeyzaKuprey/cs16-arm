From 872bcd37ea56781ec0d28d7a6b9a07630d5a695b Mon Sep 17 00:00:00 2001
From: cs16-arm <cs16-arm@local>
Date: Sat, 21 Nov 2026 00:35:57 +0200
Subject: [PATCH 1/2] arm: rep stosb inline asm is x86-only, memset fallback
 elsewhere

The MSVC __stosb intrinsic reimplementation uses x86 rep; stosb with
inline constraints; gcc on ARM rejects the constraints.  Keep the asm
on x86, plain memset (string.h already included) everywhere else.
---
 hlmaster.h | 20 ++++++++++++++------
 1 file changed, 14 insertions(+), 6 deletions(-)

diff --git a/hlmaster.h b/hlmaster.h
index 308b9c4..20da83c 100644
--- a/hlmaster.h
+++ b/hlmaster.h
@@ -51,12 +51,20 @@
 #endif
 
 #if !defined(_MSC_VER) && !defined(__clang__)
-  __forceinline static void __stosb(
-    unsigned char *Dest, const unsigned char Data, size_t Count) {
-    __asm__ __volatile__("rep; stosb"
-      : [Dest] "=D"(Dest), [Count] "=c"(Count)
-      : "[Dest]"(Dest), "a"(Data), "[Count]"(Count));
-  }
+  #if defined(__x86_64__) || defined(__i386__)
+    __forceinline static void __stosb(
+      unsigned char *Dest, const unsigned char Data, size_t Count) {
+      __asm__ __volatile__("rep; stosb"
+        : [Dest] "=D"(Dest), [Count] "=c"(Count)
+        : "[Dest]"(Dest), "a"(Data), "[Count]"(Count));
+    }
+  #else
+    // rep stosb is x86-only; plain memset everywhere else (ARM etc.)
+    __forceinline static void __stosb(
+      unsigned char *Dest, const unsigned char Data, size_t Count) {
+      memset(Dest, Data, Count);
+    }
+  #endif
 #endif
 
 typedef unsigned char u8;
-- 
2.56.1


From 39f76af1e1c0fe996d709cd01f5bcae2c5157f07 Mon Sep 17 00:00:00 2001
From: cs16-arm <cs16-arm@local>
Date: Sat, 21 Nov 2026 01:24:18 +0200
Subject: [PATCH 2/2] arm/bionic: memset for all non-MSVC compilers, not just
 gcc

clang was left without a __stosb definition at all (the asm branch is
gcc-only); memset covers clang on every arch including Bionic.
---
 hlmaster.h | 23 ++++++++---------------
 1 file changed, 8 insertions(+), 15 deletions(-)

diff --git a/hlmaster.h b/hlmaster.h
index 20da83c..96c4ecb 100644
--- a/hlmaster.h
+++ b/hlmaster.h
@@ -50,21 +50,14 @@
   struct timeval infinite = { 0, 0 };
 #endif
 
-#if !defined(_MSC_VER) && !defined(__clang__)
-  #if defined(__x86_64__) || defined(__i386__)
-    __forceinline static void __stosb(
-      unsigned char *Dest, const unsigned char Data, size_t Count) {
-      __asm__ __volatile__("rep; stosb"
-        : [Dest] "=D"(Dest), [Count] "=c"(Count)
-        : "[Dest]"(Dest), "a"(Data), "[Count]"(Count));
-    }
-  #else
-    // rep stosb is x86-only; plain memset everywhere else (ARM etc.)
-    __forceinline static void __stosb(
-      unsigned char *Dest, const unsigned char Data, size_t Count) {
-      memset(Dest, Data, Count);
-    }
-  #endif
+#if !defined(_MSC_VER)
+  // rep stosb is x86-only; compilers expand memset(Dest, Data, Count) into
+  // it on x86 anyway, so plain memset covers gcc/clang on every arch
+  // (Bionic/clang included)
+  __forceinline static void __stosb(
+    unsigned char *Dest, const unsigned char Data, size_t Count) {
+    memset(Dest, Data, Count);
+  }
 #endif
 
 typedef unsigned char u8;
-- 
