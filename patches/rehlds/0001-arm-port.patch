diff --git a/rehlds/public/rehlds/osconfig.h b/rehlds/public/rehlds/osconfig.h
index 8f76d48..ad96e82 100644
--- a/rehlds/public/rehlds/osconfig.h
+++ b/rehlds/public/rehlds/osconfig.h
@@ -88,7 +88,7 @@
 #include <fstream>
 #include <iomanip>
 
-#if defined(__aarch64__) || defined(_M_ARM64)
+#if defined(__aarch64__) || defined(_M_ARM64) || (defined(__arm__) && defined(__ARM_NEON))
 	#include "sse2neon.h"
 	// sse2neon exports _rdtsc (MSVC-style). GCC code uses the __rdtsc spelling.
 	#define __rdtsc _rdtsc
@@ -142,7 +142,7 @@
 		VirtualFree(ptr, 0, MEM_RELEASE);
 	}
 #else // _WIN32
-	#if !defined(__aarch64__)
+	#if !defined(__aarch64__) && !defined(__arm__)
 		#include <x86intrin.h>
 	#endif
 
@@ -177,7 +177,7 @@
 	#define __builtin_bswap16 _bswap16
 	#define __builtin_bswap32 _bswap
 	#define __builtin_bswap64 _bswap64
-#elif defined(__aarch64__) || defined(_M_ARM64)
+#elif defined(__aarch64__) || defined(_M_ARM64) || defined(__arm__)
 	// gcc on aarch64 doesn't accept x86 target attrs (sse4.1, ssse3, etc.).
 	// SSE-tagged inlines fall through to plain code; sse2neon emulates intrinsics.
 	#define FUNC_TARGET(x)
