From 4d3e84a32721abf911f4afb80e68afce85a3fc22 Mon Sep 17 00:00:00 2001
From: cs16-arm <cs16-arm@local>
Date: Fri, 20 Nov 2026 23:26:57 +0200
Subject: [PATCH 01/11] arm: port build to armv7-a / aarch64 (NEON)

Fan the hardcoded -m32/-msse3/no-PIC x86 assumptions out through
cmake/ArchFlags.cmake: ARCH_TUNE_FLAG (mtune=cortex-a53; gcc rejects
generic on ARM), ARCH_PIC ON (ABI-required for shared objects),
ARCH_LIB_DIR linuxarm32/linuxarm64, ARCH_IS_ARM for per-arch blocks.

- drop -flto on ARM: gcc LTO + shared-object linking produced
  R_AARCH64_ADR_PREL_PG_HI21 relocations that fail in proxy.so
- gate REHLDS_JIT to non-armv7 (AsmJit backend not wired for 32-bit
  ARM; scalar delta fallback covers it)
- sse_mathfun.h / crc32c.cpp: include sse2neon.h under ARM+NEON
- osconfig.h: guard x86 intrin includes
- mtune=generic replaced by ARCH_TUNE_FLAG everywhere it was hardcoded
---
 cmake/ArchFlags.cmake                         | 12 ++++++++++
 rehlds/CMakeLists.txt                         | 10 +++++---
 rehlds/HLTV/Console/CMakeLists.txt            |  6 +++--
 rehlds/HLTV/Core/CMakeLists.txt               | 23 +++++++++++++------
 rehlds/HLTV/DemoPlayer/CMakeLists.txt         |  6 +++--
 rehlds/HLTV/Director/CMakeLists.txt           |  6 +++--
 rehlds/HLTV/Proxy/CMakeLists.txt              |  6 +++--
 rehlds/dedicated/CMakeLists.txt               |  2 +-
 rehlds/engine/sse_mathfun.h                   |  4 ++--
 .../FileSystem_Stdio/CMakeLists.txt           |  2 +-
 rehlds/public/rehlds/crc32c.cpp               |  2 +-
 rehlds/public/rehlds/osconfig.h               |  6 ++---
 12 files changed, 59 insertions(+), 26 deletions(-)

diff --git a/cmake/ArchFlags.cmake b/cmake/ArchFlags.cmake
index eb1ac90..db1d0e2 100644
--- a/cmake/ArchFlags.cmake
+++ b/cmake/ArchFlags.cmake
@@ -21,18 +21,30 @@ option(BUILD_AMD64 "Build for x86_64 (AMD64) instead of legacy 32-bit x86." OFF)
 if (CMAKE_SYSTEM_PROCESSOR MATCHES "aarch64|arm64")
 	set(ARCH_BITNESS_FLAG "")
 	set(ARCH_SSE_FLAG "")
+	set(ARCH_TUNE_FLAG "-mtune=cortex-a53")
 	set(ARCH_PIC ON)
 	set(ARCH_LIB_DIR "linuxarm64")
 	set(ARCH_IS_X86_32 OFF)
+	set(ARCH_IS_ARM ON)
+elseif (CMAKE_SYSTEM_PROCESSOR MATCHES "armv7|^arm$")
+	set(ARCH_BITNESS_FLAG "")
+	set(ARCH_SSE_FLAG "")
+	set(ARCH_TUNE_FLAG "-mtune=cortex-a53")
+	set(ARCH_PIC ON)
+	set(ARCH_LIB_DIR "linuxarm32")
+	set(ARCH_IS_X86_32 OFF)
+	set(ARCH_IS_ARM ON)
 elseif (BUILD_AMD64)
 	set(ARCH_BITNESS_FLAG "")
 	set(ARCH_SSE_FLAG "-msse3")
+	set(ARCH_TUNE_FLAG "-mtune=generic")
 	set(ARCH_PIC ON)
 	set(ARCH_LIB_DIR "linux64")
 	set(ARCH_IS_X86_32 OFF)
 else()
 	set(ARCH_BITNESS_FLAG "-m32")
 	set(ARCH_SSE_FLAG "-msse3")
+	set(ARCH_TUNE_FLAG "-mtune=generic")
 	set(ARCH_PIC OFF)
 	set(ARCH_LIB_DIR "linux32")
 	set(ARCH_IS_X86_32 ON)
diff --git a/rehlds/CMakeLists.txt b/rehlds/CMakeLists.txt
index 6723f40..eec3747 100644
--- a/rehlds/CMakeLists.txt
+++ b/rehlds/CMakeLists.txt
@@ -66,7 +66,7 @@ else()
 	# Produce code optimized for the most common IA32/AMD64/EM64T processors.
 	# As new processors are deployed in the marketplace, the behavior of this option will change.
 	set(COMPILE_FLAGS "${COMPILE_FLAGS} \
-		-mtune=generic ${ARCH_SSE_FLAG}\
+		${ARCH_TUNE_FLAG} ${ARCH_SSE_FLAG}\
 		-fpermissive -fno-sized-deallocation\
 		-Wno-unknown-pragmas -Wno-invalid-offsetof\
 		-Wno-unused-variable -Wno-unused-result -Wno-unused-function -Wno-delete-non-virtual-dtor\
@@ -304,8 +304,12 @@ target_compile_definitions(engine PRIVATE
 # REHLDS_JIT now uses AsmJit's multi-arch codegen (x86-32, x86-64, aarch64).
 # delta_jit.cpp emits per-field comparisons via asmjit::x86::Compiler or
 # asmjit::a64::Compiler depending on the host arch.
-target_compile_definitions(engine PRIVATE REHLDS_JIT)
-target_compile_definitions(engine PRIVATE $<$<CONFIG:Unittests>:REHLDS_JIT>)
+# armv7 (32-bit ARM) has no AsmJit backend wired here — use the scalar
+# delta path (REHLDS_FIXES fallback in delta.cpp) instead.
+if (NOT CMAKE_SYSTEM_PROCESSOR MATCHES "armv7|^arm$")
+	target_compile_definitions(engine PRIVATE REHLDS_JIT)
+	target_compile_definitions(engine PRIVATE $<$<CONFIG:Unittests>:REHLDS_JIT>)
+endif()
 
 target_sources(engine PRIVATE
 	${COMMON_SRCS}
