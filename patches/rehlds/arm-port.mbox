From c38b7e8b346208a40dc1d87f9808b738259eb9df Mon Sep 17 00:00:00 2001
From: cs16-arm <cs16-arm@local>
Date: Sat, 21 Nov 2026 01:54:51 +0200
Subject: [PATCH 03/11] bionic: version-script link flag only off-Android (lld
 rejects _init/_fini)

---
 rehlds/CMakeLists.txt | 15 +++++++++++----
 1 file changed, 11 insertions(+), 4 deletions(-)

diff --git a/rehlds/CMakeLists.txt b/rehlds/CMakeLists.txt
index eec3747..e273ea1 100644
--- a/rehlds/CMakeLists.txt
+++ b/rehlds/CMakeLists.txt
@@ -89,10 +89,17 @@ if (CMAKE_CXX_COMPILER_VERSION VERSION_GREATER_EQUAL 8.0)
 	set(COMPILE_FLAGS "${COMPILE_FLAGS} -fcf-protection=none")
 endif()
 
-if (NOT DEBUG)
-	set(LINK_FLAGS "${LINK_FLAGS} \
-		-Wl,-gc-sections -Wl,--version-script=\"${PROJECT_SOURCE_DIR}/../version_script.lds\"")
-endif()
+	if (NOT DEBUG)
+		if (ANDROID)
+			# lld rejects version-script symbols that don't exist (_init/_fini
+			# don't exist in bionic shared objects); exports come from EXT_FUNC
+			# default visibility instead
+			set(LINK_FLAGS "${LINK_FLAGS} -Wl,-gc-sections")
+		else()
+			set(LINK_FLAGS "${LINK_FLAGS} \
+				-Wl,-gc-sections -Wl,--version-script=\"${PROJECT_SOURCE_DIR}/../version_script.lds\")
+		endif()
+	endif()
 
 set(PROJECT_SRC_DIR
 	"${PROJECT_SOURCE_DIR}"
-- 
