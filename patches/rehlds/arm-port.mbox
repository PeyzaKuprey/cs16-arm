From a1ad7b287840b254fc95ad7aa7360d4325be02cf Mon Sep 17 00:00:00 2001
From: cs16-arm <cs16-arm@local>
Date: Sat, 21 Nov 2026 03:00:08 +0200
Subject: [PATCH 07/11] bionic: drop __xstat family wraps (bionic stat is the
 xstat)

---
 rehlds/filesystem/FileSystem_Stdio/CMakeLists.txt    | 6 +++++-
 rehlds/filesystem/FileSystem_Stdio/src/pathmatch.cpp | 3 +++
 2 files changed, 8 insertions(+), 1 deletion(-)

diff --git a/rehlds/filesystem/FileSystem_Stdio/CMakeLists.txt b/rehlds/filesystem/FileSystem_Stdio/CMakeLists.txt
index a452d75..cb55a18 100644
--- a/rehlds/filesystem/FileSystem_Stdio/CMakeLists.txt
+++ b/rehlds/filesystem/FileSystem_Stdio/CMakeLists.txt
@@ -42,10 +42,14 @@ endif()
 # NOTE: Don't use IPO or LTO with '--wrap' may make this feature ineffective
 set(WRAP_FUNCS_LIST
 	"scandir" "opendir" "freopen" "fopen" "fopen64" "open" "open64" "creat"
-	"access" "stat" "lstat" "__xstat" "__lxstat" "__xstat64" "__lxstat64"
+	"access" "stat" "lstat"
 	"chmod" "chown" "lchown" "unlink" "symlink" "link" "mknod" "mount"
 	"mkfifo" "rename" "utime" "utimes" "mkdir" "rmdir"
 )
+if (NOT ANDROID)
+	# glibc's __xstat variants don't exist in bionic (stat IS the xstat)
+	set(WRAP_FUNCS_LIST ${WRAP_FUNCS_LIST} "__xstat" "__lxstat" "__xstat64" "__lxstat64")
+endif()
 
 foreach(f ${WRAP_FUNCS_LIST})
 	set(LINK_FLAGS "${LINK_FLAGS} -Wl,-wrap,${f}")
diff --git a/rehlds/filesystem/FileSystem_Stdio/src/pathmatch.cpp b/rehlds/filesystem/FileSystem_Stdio/src/pathmatch.cpp
index a632861..3d7f08f 100644
--- a/rehlds/filesystem/FileSystem_Stdio/src/pathmatch.cpp
+++ b/rehlds/filesystem/FileSystem_Stdio/src/pathmatch.cpp
@@ -790,6 +790,7 @@ extern "C" {
 		return CALL(opendir)(CWrap(name, false));
 	}
 
+#ifndef __BIONIC__
 	WRAP(__xstat, int, int __ver, __const char *__filename, struct stat *__stat_buf)
 	{
 		return CALL(__xstat)(__ver, CWrap(__filename, false), __stat_buf);
@@ -810,6 +811,8 @@ extern "C" {
 		return CALL(__lxstat64)(__ver, CWrap(__filename, false), __stat_buf);
 	}
 
+#endif // __BIONIC__
+
 	WRAP(chmod, int, const char *path, mode_t mode)
 	{
 		return CALL(chmod)(CWrap(path, false), mode);
