From 9c40ccdf7e904d98736fca4a286f9680361a3a82 Mon Sep 17 00:00:00 2001
From: cs16-arm <cs16-arm@local>
Date: Fri, 20 Nov 2026 23:49:28 +0200
Subject: [PATCH 2/3] arm: actually wire METAMOD_CPP_CALLBACKS and drop JIT
 tramps under it
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Three separate bugs kept the armv7 build on the x86 JIT path:

1. The CMake option was never turned into a compile definition —
   every armv7 build compiled callback_jit_x86.cpp and crashed on
   first engine-table call (executing x86 bytes on ARM). Wire the
   definition via target_compile_definitions + declare the option.
2. engine_api.cpp never included callback_cpp.h, so the C++ CDATA
   variant referenced an undefined CPP_CDATA_FIELDS.
3. compile_engine_tramps / compile_gamedll_tramps / meta_rebuild
   _callbacks still generated x86 JIT trampolines into the tables
   handed to the engine and gamedll, and used the JIT-only live-frame
   retaddr fixup on plugin reload. Under the C++ mode the wrapper
   pointers go straight into g_meta_engfuncs / sFunctionTable /
   sNewFunctionTable (reading originals from the source tables, since
   the tramps used to run before the _jit fills), and the rebuild path
   just refreshes the jitdata snapshots — wrapper addresses are stable
   and the dispatchers read the live plugin list.
---
 metamod/CMakeLists.txt     |  2 ++
 metamod/src/dllapi.cpp     | 18 ++++++++++++++++++
 metamod/src/engine_api.cpp | 14 ++++++++++++++
 metamod/src/metamod.cpp    |  9 +++++++++
 4 files changed, 43 insertions(+)

diff --git a/metamod/CMakeLists.txt b/metamod/CMakeLists.txt
index fbee9d1..d03b143 100644
--- a/metamod/CMakeLists.txt
+++ b/metamod/CMakeLists.txt
@@ -32,6 +32,7 @@ option(DEBUG "Build with debug information." OFF)
 option(USE_STATIC_LIBSTDC "Enables static linking libstdc++." OFF)
 option(BUILD_64BIT "Build 64-bit x86_64 version instead of 32-bit x86." OFF)
 option(BUILD_AARCH64 "Build for AArch64 (ARM64) target." OFF)
+option(METAMOD_CPP_CALLBACKS "Statically-compiled C++ callback wrappers instead of the AsmJit JIT (required for armv7, which has no JIT backend)." OFF)
 
 # Auto-detect AArch64 host when neither toggle is specified explicitly.
 if (NOT BUILD_AARCH64 AND NOT BUILD_64BIT
@@ -197,6 +198,7 @@ target_compile_definitions(metamod PRIVATE
 	NDEBUG
 	METAMOD_CORE
 	_GLIBCXX_USE_CXX11_ABI=0
+	$<$<BOOL:${METAMOD_CPP_CALLBACKS}>:METAMOD_CPP_CALLBACKS>
 	_stricmp=strcasecmp
 	_strnicmp=strncasecmp
 	_strdup=strdup
diff --git a/metamod/src/dllapi.cpp b/metamod/src/dllapi.cpp
index 684adbe..a15a99f 100644
--- a/metamod/src/dllapi.cpp
+++ b/metamod/src/dllapi.cpp
@@ -318,6 +318,23 @@ void compile_newdllfunc_callbacks()
 
 void compile_gamedll_tramps()
 {
+#ifdef METAMOD_CPP_CALLBACKS
+	// No JIT on this target: the engine gets the C++ wrapper pointers
+	// directly. Read the originals from the gamedll's own tables — the
+	// _jit tables are filled after this runs.
+	for (auto& cd : g_dllfunc_cdata) {
+		size_t fn = cd.wrapper ? cd.wrapper : *(size_t *)(size_t(g_GameDLL.funcs.dllapi_table) + cd.offset);
+		*(size_t *)(size_t(&sFunctionTable) + cd.offset) = fn;
+	}
+
+	// use direct hook to prevent crash after callbacks rebuilding
+	sFunctionTable.pfnServerDeactivate = mm_ServerDeactivate;
+
+	for (auto& cd : g_newdllfunc_cdata) {
+		size_t fn = cd.wrapper ? cd.wrapper : (g_GameDLL.funcs.newapi_table ? *(size_t *)(size_t(g_GameDLL.funcs.newapi_table) + cd.offset) : 0);
+		*(size_t *)(size_t(&sNewFunctionTable) + cd.offset) = fn;
+	}
+#else
 	// we compile simple static functions that will call dynamic callbacks
 	for (auto& cd : g_dllfunc_cdata) {
 		*(size_t *)(size_t(&sFunctionTable) + cd.offset) = g_jit.compile_tramp(size_t(&sFunctionTable_jit) + cd.offset);
@@ -329,6 +346,7 @@ void compile_gamedll_tramps()
 	for (auto& cd : g_newdllfunc_cdata) {
 		*(size_t *)(size_t(&sNewFunctionTable) + cd.offset) = g_jit.compile_tramp(size_t(&sNewFunctionTable_jit) + cd.offset);
 	}
+#endif
 }
 
 void compile_gamedll_callbacks()
diff --git a/metamod/src/engine_api.cpp b/metamod/src/engine_api.cpp
index fcf150c..e99be70 100644
--- a/metamod/src/engine_api.cpp
+++ b/metamod/src/engine_api.cpp
@@ -1,5 +1,9 @@
 #include "precompiled.h"
 
+#ifdef METAMOD_CPP_CALLBACKS
+#include "callback_cpp.h"
+#endif
+
 #define CDATA_ENG_H(x, p, h)		CDATA_ENTRY(enginefuncs_t, x, p, size_t(h))
 #define CDATA_ENG(x)				CDATA_ENTRY(enginefuncs_t, x, P_PRE, 0u)
 
@@ -226,10 +230,20 @@ void compile_engfuncs_callbacks()
 
 void compile_engine_tramps()
 {
+#ifdef METAMOD_CPP_CALLBACKS
+	// No JIT on this target: hand the gamedll the C++ wrapper pointers
+	// directly (the wrapper reads its jitdata live, so the tramp layer's
+	// rebuildable-indirection trick is unnecessary).
+	for (auto& cd : g_engfuncs_cdata) {
+		size_t fn = cd.wrapper ? cd.wrapper : *(size_t *)(size_t(&g_engfuncs) + cd.offset);
+		*(size_t *)(size_t(&g_meta_engfuncs) + cd.offset) = fn;
+	}
+#else
 	// we compile simple static functions that will call dynamic callbacks
 	for (auto& cd : g_engfuncs_cdata) {
 		*(size_t *)(size_t(&g_meta_engfuncs) + cd.offset) = g_jit.compile_tramp(size_t(&g_meta_engfuncs_jit) + cd.offset/*, cd.mm_hook, cd.mm_hook_time*/);
 	}
+#endif
 }
 
 void compile_engine_callbacks()
diff --git a/metamod/src/metamod.cpp b/metamod/src/metamod.cpp
index edb96cc..e1a9bb9 100644
--- a/metamod/src/metamod.cpp
+++ b/metamod/src/metamod.cpp
@@ -493,6 +493,15 @@ void meta_rebuild_callbacks()
 {
 	if (!g_metamod_active) return;
 
+#ifdef METAMOD_CPP_CALLBACKS
+	// Wrapper addresses are stable and the dispatchers read the live
+	// plugin list, so there is no code to regenerate and no live-frame
+	// return addresses to re-point. Just refresh the jitdata snapshots.
+	compile_engine_callbacks();
+	compile_gamedll_callbacks();
+	return;
+#endif
+
 	std::vector<fixdata_t> fixdata;
 	if (g_metaGlobals.esp_save) {
 		META_LOG("dll: Begin scan to collect callback fix data...");
-- 
