From d6924d22688607d9ad4313d778a722d6f54c5f22 Mon Sep 17 00:00:00 2001
From: cs16-arm <cs16-arm@local>
Date: Fri, 20 Nov 2026 23:27:10 +0200
Subject: [PATCH 1/3] arm: build for armv7-a / aarch64

- ARCH_ARM detection: skip x86 tuning flags, PIC required for the
  shared object (POSITION_INDEPENDENT_CODE ON on ARM, OFF on x86-32
  as upstream)
- DebuggerBreak: int3 is x86-only; use __builtin_trap elsewhere

see ReHLDS arm branch (same toolchain assumptions fanned out)
---
 regamedll/CMakeLists.txt          | 24 +++++++++++++++++++-----
 regamedll/public/tier0/platform.h | 10 ++++++++--
 2 files changed, 27 insertions(+), 7 deletions(-)

diff --git a/regamedll/CMakeLists.txt b/regamedll/CMakeLists.txt
index 7861842..1ca6f70 100644
--- a/regamedll/CMakeLists.txt
+++ b/regamedll/CMakeLists.txt
@@ -28,6 +28,13 @@ option(USE_LEGACY_LIBC "Enables linking against legacy libc (<= 2.15) for compat
 option(X64BITS "Build a 64-bit library on a 64-bit system." OFF)
 option(XASH_COMPAT "Enable Xash3D FWGS compatiblity (support for it's 64-bit ABI support and crossplatform library suffix)")
 
+# ARM (aarch64 / armv7) detection: no -msse3, PIC required
+if (CMAKE_SYSTEM_PROCESSOR MATCHES "aarch64|arm64|armv7|^arm$")
+	set(ARCH_ARM ON)
+else()
+	set(ARCH_ARM OFF)
+endif()
+
 # Xash3D FWGS is 64-bit wherever the system is
 if (XASH_COMPAT AND CMAKE_SIZEOF_VOID_P EQUAL 8)
 	set(X64BITS ON)
@@ -109,7 +116,7 @@ if (CMAKE_CXX_COMPILER_ID STREQUAL "Intel")
 		set(LINK_FLAGS "${LINK_FLAGS} -ipo")
 	endif()
 elseif (CMAKE_CXX_COMPILER_ID STREQUAL "GNU" OR CMAKE_CXX_COMPILER_ID STREQUAL "Clang")
-	if (NOT XASH_COMPAT OR XASH_AMD64 OR XASH_X86)
+	if (NOT ARCH_ARM AND (NOT XASH_COMPAT OR XASH_AMD64 OR XASH_X86))
 		# Produce code optimized for the most common IA32/AMD64/EM64T processors.
 		# As new processors are deployed in the marketplace, the behavior of this option will change.
 		set(COMPILE_FLAGS "${COMPILE_FLAGS} \
@@ -450,10 +457,17 @@ elseif (X64BITS)
 else()
 	set(LINK_FLAGS "${LINK_FLAGS} -Wl,-z,notext")
 
-set_target_properties(regamedll PROPERTIES
-		OUTPUT_NAME cs
-		PREFIX ""
-		POSITION_INDEPENDENT_CODE OFF)
+	if (ARCH_ARM)
+		set_target_properties(regamedll PROPERTIES
+			OUTPUT_NAME cs
+			PREFIX ""
+			POSITION_INDEPENDENT_CODE ON)
+	else()
+		set_target_properties(regamedll PROPERTIES
+			OUTPUT_NAME cs
+			PREFIX ""
+			POSITION_INDEPENDENT_CODE OFF)
+	endif()
 endif()
 
 install(TARGETS regamedll
diff --git a/regamedll/public/tier0/platform.h b/regamedll/public/tier0/platform.h
index 230bcab..a9f8ad0 100644
--- a/regamedll/public/tier0/platform.h
+++ b/regamedll/public/tier0/platform.h
@@ -41,8 +41,14 @@
 #endif
 
 // Used to step into the debugger
-#if defined(__GNUC__) || defined(__clang__)
-	#define DebuggerBreak() __asm__ __volatile__("int3;")
+#if defined(__i386__) || defined(__x86_64__) || defined(_M_IX86) || defined(_M_X64)
+	#if defined(__GNUC__) || defined(__clang__)
+		#define DebuggerBreak() __asm__ __volatile__("int3;")
+	#else
+		#define DebuggerBreak() __debugbreak()
+	#endif
+#elif defined(__GNUC__) || defined(__clang__)
+	#define DebuggerBreak() __builtin_trap()
 #else
 	#define DebuggerBreak() __debugbreak()
 #endif
-- 
2.56.1


From 37bffb9baf246501fe64b1c5f094c9ac37d1ffd1 Mon Sep 17 00:00:00 2001
From: cs16-arm <cs16-arm@local>
Date: Sat, 21 Nov 2026 01:47:09 +0200
Subject: [PATCH 2/3] bionic: version-script link flag only off-Android (lld
 rejects _init/_fini)

---
 regamedll/CMakeLists.txt | 15 +++++++++++----
 1 file changed, 11 insertions(+), 4 deletions(-)

diff --git a/regamedll/CMakeLists.txt b/regamedll/CMakeLists.txt
index 1ca6f70..bf92d60 100644
--- a/regamedll/CMakeLists.txt
+++ b/regamedll/CMakeLists.txt
@@ -151,10 +151,17 @@ elseif (CMAKE_CXX_COMPILER_ID STREQUAL "GNU" OR CMAKE_CXX_COMPILER_ID STREQUAL "
 	endif()
 endif()
 
-if (NOT DEBUG)
-	set(LINK_FLAGS "${LINK_FLAGS} \
-		-Wl,-gc-sections -Wl,--version-script=\"${PROJECT_SOURCE_DIR}/../version_script.lds\"")
-endif()
+	if (NOT DEBUG)
+		if (ANDROID)
+			# lld rejects version-script symbols that don't exist (_init/_fini
+			# don't exist in bionic shared objects); exports come from EXT_FUNC
+			# default visibility instead
+			set(LINK_FLAGS "${LINK_FLAGS} -Wl,-gc-sections")
+		else()
+			set(LINK_FLAGS "${LINK_FLAGS} \
+				-Wl,-gc-sections -Wl,--version-script=\"${PROJECT_SOURCE_DIR}/../version_script.lds\")
+		endif()
+	endif()
 
 find_program(CCACHE_FOUND ccache)
 if (CCACHE_FOUND)
-- 
