+if (CMAKE_CXX_COMPILER_VERSION VERSION_GREATER_EQUAL 8.0 AND NOT CMAKE_SYSTEM_PROCESSOR MATCHES "aarch64|arm64|armv7|^arm$")
 	set(COMPILE_FLAGS "${COMPILE_FLAGS} -fcf-protection=none")
 endif()
 
@@ -129,6 +143,12 @@ set(REUNION_SRCS
 
 add_library(reunion SHARED ${appversion.sh})
 
+if (CMAKE_SYSTEM_PROCESSOR MATCHES "aarch64|arm64")
+	set(REUNION_OUTPUT_NAME reunion_mm_aarch64)
