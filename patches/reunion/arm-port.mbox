diff --git a/reunion/CMakeLists.txt b/reunion/CMakeLists.txt
index 6593ed4..c366ed2 100644
--- a/reunion/CMakeLists.txt
+++ b/reunion/CMakeLists.txt
@@ -29,10 +29,24 @@ set(CMAKE_CXX_STANDARD_REQUIRED ON)
 # Avoid -fPIC option
 set(CMAKE_SHARED_LIBRARY_CXX_FLAGS "")
 
-set(COMPILE_FLAGS "-m32 -U_FORTIFY_SOURCE")
-set(LINK_FLAGS "-m32 -s")
+set(COMPILE_FLAGS "-U_FORTIFY_SOURCE")
+set(LINK_FLAGS "")
+
+if (CMAKE_SYSTEM_PROCESSOR MATCHES "aarch64|arm64|armv7|^arm$")
+	# ARM targets: no -m32/-msse3, PIC required for shared objects
+	set(COMPILE_FLAGS "${COMPILE_FLAGS} -fPIC")
+else()
+	set(COMPILE_FLAGS "${COMPILE_FLAGS} -m32")
+	set(LINK_FLAGS "-m32")
+endif()
 
