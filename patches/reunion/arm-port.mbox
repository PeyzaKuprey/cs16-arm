From 128f1be6a8a1828dc0a6370fe1d1eca8de620173 Mon Sep 17 00:00:00 2001
From: cs16-arm <cs16-arm@local>
Date: Sat, 21 Nov 2026 01:54:51 +0200
Subject: [PATCH 4/4] bionic: version-script link flag only off-Android (lld
 rejects _init/_fini)

---
 reunion/CMakeLists.txt | 15 +++++++++++----
 1 file changed, 11 insertions(+), 4 deletions(-)

diff --git a/reunion/CMakeLists.txt b/reunion/CMakeLists.txt
index cf65856..e7c2970 100644
--- a/reunion/CMakeLists.txt
+++ b/reunion/CMakeLists.txt
@@ -91,10 +91,17 @@ if (CMAKE_CXX_COMPILER_VERSION VERSION_GREATER_EQUAL 8.0 AND NOT CMAKE_SYSTEM_PR
 	set(COMPILE_FLAGS "${COMPILE_FLAGS} -fcf-protection=none")
 endif()
 
-if (NOT DEBUG)
-	set(LINK_FLAGS "${LINK_FLAGS} \
-		-Wl,-gc-sections -Wl,--version-script=\"${PROJECT_SOURCE_DIR}/../version_script.lds\"")
-endif()
+	if (NOT DEBUG)
+		if (ANDROID)
+			# lld rejects version-script symbols that don't exist (_init/_fini
+			# don't exist in bionic shared objects); exports come from EXT_FUNC
+			# default visibility instead
+			set(LINK_FLAGS "${LINK_FLAGS} -Wl,-gc-sections")
+		else()
+			set(LINK_FLAGS "${LINK_FLAGS} \
+				-Wl,-gc-sections -Wl,--version-script=\"${PROJECT_SOURCE_DIR}/../version_script.lds\")
+		endif()
+	endif()
 
 #PROJECT_SOURCE_DIR - /mnt/d/GitHub/reunion/reunion
 
