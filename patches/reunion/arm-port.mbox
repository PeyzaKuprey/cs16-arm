+# ARM's char is unsigned by default: Rijndael's signed S-box tables then
+# trigger brace-init narrowing errors. -fpermissive (same flag ReHLDS uses)
+# downgrades them to warnings.
+if (CMAKE_SYSTEM_PROCESSOR MATCHES "aarch64|arm64|armv7|^arm$")
+	set(COMPILE_FLAGS "${COMPILE_FLAGS} -fpermissive")
+endif()
 
 # Remove noxref code and data
