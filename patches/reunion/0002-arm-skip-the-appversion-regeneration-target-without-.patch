From 2c6441c1ae365c435e2523dfa4294d661a844d41 Mon Sep 17 00:00:00 2001
From: cs16-arm <cs16-arm@local>
Date: Sat, 21 Nov 2026 00:36:08 +0200
Subject: [PATCH 2/2] arm: skip the appversion regeneration target without the
 sibling scaffolding

appversion.sh lives in an untracked ../version/ dir and reads a sibling
ReHLDS checkout; a fresh checkout of ReUnion alone has neither, so the
custom target broke the build.  The pinned reunion/version/appversion.h
(the file the code actually includes) is enough.
---
 reunion/CMakeLists.txt | 12 ++++++++----
 1 file changed, 8 insertions(+), 4 deletions(-)

diff --git a/reunion/CMakeLists.txt b/reunion/CMakeLists.txt
index c366ed2..034a5d5 100644
--- a/reunion/CMakeLists.txt
+++ b/reunion/CMakeLists.txt
@@ -149,12 +149,16 @@ elseif (CMAKE_SYSTEM_PROCESSOR MATCHES "armv7|^arm$")
 	set(REUNION_OUTPUT_NAME reunion_mm_armv7)
 endif()
 
-if (NOT TARGET appversion)
-	add_custom_target(appversion DEPENDS COMMAND "${PROJECT_SOURCE_DIR}/../version/appversion.sh" "${PROJECT_SOURCE_DIR}/..")
+# appversion.sh regenerates ../version/appversion.h from a sibling ReHLDS
+# checkout; when that scaffolding isn't present (fresh checkout of this repo
+# alone), rely on the pinned reunion/version/appversion.h instead.
+if (EXISTS "${PROJECT_SOURCE_DIR}/../version/appversion.sh")
+	if (NOT TARGET appversion)
+		add_custom_target(appversion DEPENDS COMMAND "${PROJECT_SOURCE_DIR}/../version/appversion.sh" "${PROJECT_SOURCE_DIR}/..")
+	endif()
+	add_dependencies(reunion appversion)
 endif()
 
-add_dependencies(reunion appversion)
-
 target_include_directories(reunion PRIVATE
 	${PROJECT_SRC_DIR}
 	${PROJECT_HLSDK_DIR}
-- 
