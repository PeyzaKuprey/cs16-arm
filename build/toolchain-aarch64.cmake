# Bootlin aarch64 toolchain (gcc 10.3, glibc 2.34) — target: Debian bookworm+ / proot-distro
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
get_filename_component(TC_ROOT "${CMAKE_CURRENT_LIST_DIR}/../toolchains/aarch64" ABSOLUTE)
set(CMAKE_C_COMPILER   ${TC_ROOT}/bin/aarch64-buildroot-linux-gnu-gcc)
set(CMAKE_CXX_COMPILER ${TC_ROOT}/bin/aarch64-buildroot-linux-gnu-g++)
set(CMAKE_SYSROOT      ${TC_ROOT}/aarch64-buildroot-linux-gnu/sysroot)
set(CMAKE_FIND_ROOT_PATH ${CMAKE_SYSROOT})
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)